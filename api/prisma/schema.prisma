  contentHash       String?          @map("content_hash") @db.VarChar(128)
  immutableAt       DateTime?        @map("immutable_at") @db.Timestamptz(6)

  @@index([encounterId])
  @@index([patientId, consentType])
  @@map("consents")
}

/// Consentimiento informado firmado + PDF inalterable (Ley 1581 / Ley 1090).
/// Para menores de edad la firma principal usa signerRole = LEGAL_GUARDIAN
/// (acudiente/responsable legal); una sola firma es suficiente.
model PatientConsent {
  id                 String            @id @default(uuid()) @db.Uuid
  clinicId           String            @map("clinic_id") @db.Uuid
  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId          String            @map("patient_id") @db.Uuid
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId        String?           @map("encounter_id") @db.Uuid
  encounter          Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  templateId         String            @map("template_id") @db.Uuid
  template           ConsentTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  signerRole         ConsentSignerRole @default(PATIENT) @map("signer_role")
  signerName         String?           @map("signer_name") @db.VarChar(160)
  signerDocumentType String?           @map("signer_document_type") @db.VarChar(20)
  signerDocument     String?           @map("signer_document") @db.VarChar(40)
  signatureBase64    String            @map("signature_base64")
  signedAt           DateTime          @map("signed_at") @db.Timestamptz(6)
  ipAddress          String?           @map("ip_address") @db.VarChar(60)
  userAgent          String?           @map("user_agent")
  pdfStorageKey      String?           @map("pdf_storage_key")
  contentHash        String?           @map("content_hash") @db.VarChar(128)
  immutableAt        DateTime?         @map("immutable_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// ACEPTADO | REVOCADO (PENDIENTE_FIRMA vive en RemoteConsentInvite).
  status                      String    @default("ACEPTADO") @db.VarChar(20)
  /// Detalle estructurado de los CI (dientes FDI, opciones, riesgos aceptados).
  procedureDetails            Json?     @map("procedure_details")
  professionalSignatureBase64 String?   @map("professional_signature_base64")
  revokedAt                   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason            String?   @map("revocation_reason")
  revocationSignerName        String?   @map("revocation_signer_name") @db.VarChar(160)
  revocationSignatureBase64   String?   @map("revocation_signature_base64")
  revocationIp                String?   @map("revocation_ip") @db.VarChar(60)
  revocationUserAgent         String?   @map("revocation_user_agent")
  revocationHash              String?   @map("revocation_hash") @db.VarChar(128)
  revocationPdfStorageKey     String?   @map("revocation_pdf_storage_key")

  @@index([patientId, templateId])
  @@index([encounterId])
  @@index([encounterId, templateId, signerRole])
  @@index([clinicId, signedAt])
  @@map("patient_consents")
}

/// Invitación de firma remota por correo (atención virtual). Caduca en 7 días.
model RemoteConsentInvite {
  id              String          @id @default(uuid()) @db.Uuid
  clinicId        String          @map("clinic_id") @db.Uuid
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String          @map("patient_id") @db.Uuid
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId     String?         @map("encounter_id") @db.Uuid
  encounter       Encounter?      @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  templateId      String          @map("template_id") @db.Uuid
  template        ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  invitedById     String          @map("invited_by_id") @db.Uuid
  invitedBy       User            @relation("RemoteConsentInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  /// Token opaco en claro solo se entrega por WhatsApp/correo; en BD se guarda el hash SHA-256.
  tokenHash       String          @unique @map("token_hash") @db.VarChar(64)
  sentToEmail     String?         @map("sent_to_email") @db.VarChar(180)
  sentToPhone     String?         @map("sent_to_phone") @db.VarChar(40)
  status          String          @default("PENDING") @db.VarChar(20)
  expiresAt       DateTime        @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?       @map("used_at") @db.Timestamptz(6)
  patientConsentId String?        @map("patient_consent_id") @db.Uuid
  /// Detalle CI diligenciado por la profesional antes de enviar el enlace.
  procedureDetails Json?          @map("procedure_details")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clinicId, status])
  @@index([patientId, createdAt])
  @@index([expiresAt])
  @@map("remote_consent_invites")
}


/// Flags ligeros de HCE (INFORMED / DATA_PROCESSING). El PDF sellado vive en PatientConsent.
model ClinicalConsent {
  id                String           @id @default(uuid()) @db.Uuid
  clinicId          String?          @map("clinic_id") @db.Uuid
  clinic            Clinic?          @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  patientId         String?          @map("patient_id") @db.Uuid
  patient           Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounterId       String?          @map("encounter_id") @db.Uuid
  encounter         Encounter?       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  consentType       String           @map("consent_type") @db.VarChar(60)
  templateCode      String?          @map("template_code") @db.VarChar(60)
  procedureCupsCode String?          @map("procedure_cups_code") @db.VarChar(20)
  granted           Boolean          @default(false)
  grantedAt         DateTime?        @map("granted_at") @db.Timestamptz(6)
  evidencePath      String?          @map("evidence_path")
  signedPayload     Json?            @map("signed_payload")
  signatureMethod   SignatureMethod? @map("signature_method")
  contentHash       String?          @map("content_hash") @db.VarChar(128)
  immutableAt       DateTime?        @map("immutable_at") @db.Timestamptz(6)

  @@index([encounterId])
  @@index([patientId, consentType])
  @@map("consents")
}

/// Consentimiento informado firmado + PDF inalterable (Ley 1581 / Ley 1090)
model PatientConsent {
  id                 String            @id @default(uuid()) @db.Uuid
  clinicId           String            @map("clinic_id") @db.Uuid
  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId          String            @map("patient_id") @db.Uuid
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId        String?           @map("encounter_id") @db.Uuid
  encounter          Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  templateId         String            @map("template_id") @db.Uuid
  template           ConsentTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  signerRole         ConsentSignerRole @default(PATIENT) @map("signer_role")
  signerName         String?           @map("signer_name") @db.VarChar(160)
  signerDocumentType String?           @map("signer_document_type") @db.VarChar(20)
  signerDocument     String?           @map("signer_document") @db.VarChar(40)
  signatureBase64    String            @map("signature_base64")
  signedAt           DateTime          @map("signed_at") @db.Timestamptz(6)
  ipAddress          String?           @map("ip_address") @db.VarChar(60)
  userAgent          String?           @map("user_agent")
  pdfStorageKey      String?           @map("pdf_storage_key")
  contentHash        String?           @map("content_hash") @db.VarChar(128)
  immutableAt        DateTime?         @map("immutable_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([patientId, templateId])
  @@index([encounterId])
  @@index([encounterId, templateId, signerRole])
  @@index([clinicId, signedAt])
  @@map("patient_consents")
}


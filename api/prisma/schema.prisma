model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  clinicId    String          @map("clinic_id") @db.Uuid
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  type        TransactionType
  category    String          @db.VarChar(80)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("COP") @db.VarChar(3)
  invoiceId   String?         @map("invoice_id") @db.Uuid
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paidAt      DateTime        @map("paid_at") @db.Timestamptz(6)
  method      PaymentMethod   @default(CASH)
  notes       String?
  createdById String?         @map("created_by_id") @db.Uuid
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clinicId, paidAt])
  @@index([type, category])
  @@map("transactions")
}

// ─── Ingresos de plataforma (SUPER_ADMIN / HabiliSALUD) ─────────────────────

enum PlatformPlanVariant {
  WITHOUT_DOCS
  WITH_DOCS
}

enum PlatformChargeKind {
  CLINIC_SETUP
  MONTHLY_HOSTING
  OTHER
}

/// Tarifas editables: alta con/sin documentación y arrendamiento mensual del servidor.
model PlatformFee {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique @db.VarChar(60)
  label     String              @db.VarChar(160)
  kind      PlatformChargeKind
  plan      PlatformPlanVariant
  amount    Decimal             @db.Decimal(12, 2)
  currency  String              @default("COP") @db.VarChar(3)
  isActive  Boolean             @default(true) @map("is_active")
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_fees")
}

/// Recibos de cobro HabiliSALUD a consultorios (alta + arrendamiento servidor).
model PlatformReceipt {
  id          String              @id @default(uuid()) @db.Uuid
  number      String              @unique @db.VarChar(40)
  clinicId    String              @map("clinic_id") @db.Uuid
  clinic      Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  kind        PlatformChargeKind
  plan        PlatformPlanVariant
  description String              @db.VarChar(255)
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("COP") @db.VarChar(3)
  method      PaymentMethod       @default(TRANSFER)
  /// PENDING: cuenta de cobro emitida sin pago; no cuenta como ingreso.
  status      PlatformReceiptStatus @default(PAID)
  /// Fecha del pago; null mientras el cobro está pendiente.
  paidAt      DateTime?           @map("paid_at") @db.Timestamptz(6)
  /// Mes de servicio para arrendamiento (YYYY-MM-01).
  periodMonth DateTime?           @map("period_month") @db.Date
  notes       String?
  /// Admin y datos del consultorio a la fecha del cobro (para el recibo).
  payerName     String?           @map("payer_name") @db.VarChar(160)
  payerDocument String?           @map("payer_document") @db.VarChar(40)
  payerPhone    String?           @map("payer_phone") @db.VarChar(40)
  payerEmail    String?           @map("payer_email") @db.VarChar(180)
  /// Plan del consultorio a la fecha del cobro.
  planLabel     String?           @map("plan_label") @db.VarChar(160)
  /// Copia del PDF pagado archivada para el consultorio (stored_files).
  pdfStorageKey String?           @map("pdf_storage_key")
  createdById String?             @map("created_by_id") @db.Uuid
  createdBy   User?               @relation("PlatformReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([paidAt])
  @@index([status])
  @@index([clinicId, kind, periodMonth])
  @@map("platform_receipts")
}

enum PlatformReceiptStatus {
  PAID
  PENDING
}

model QualitySnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @map("clinic_id") @db.Uuid
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  incompleteHcRate Float    @map("incomplete_hc_rate")
  avgCloseHours    Float    @map("avg_close_hours")
  consentGapCount  Int      @map("consent_gap_count")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([clinicId, date])
  @@map("quality_snapshots")
}

// ─── Gestión documental / equipos / PAMEC ───────────────────────────────────

model DocumentCategory {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique @db.VarChar(40)
  name      String         @db.VarChar(160)
  /// Estándar de habilitación (Res. 3100 de 2019) o pilar SG-SST al que se agrupa en el dashboard.
  pillar    DocumentPillar @default(PROCESOS_PRIORITARIOS)
  sortOrder Int            @default(0) @map("sort_order")
  /// Tipo documental desactivado: no se ofrece para documentos nuevos; los existentes se conservan.
  isActive  Boolean        @default(true) @map("is_active")

  requirements DocumentRequirement[]

  @@index([pillar])
  @@map("document_categories")
}

model DocumentRequirement {
  id           String           @id @default(uuid()) @db.Uuid
  clinicId     String           @map("clinic_id") @db.Uuid
  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  categoryId   String           @map("category_id") @db.Uuid
  category     DocumentCategory @relation(fields: [categoryId], references: [id])
  code         String           @db.VarChar(60)
  title        String           @db.VarChar(255)
  description  String?
  isMandatory  Boolean          @default(true) @map("is_mandatory")
  /// Si está deshabilitado, el consultorio no lo ve ni puede editar/firmar.
  isEnabled    Boolean          @default(true) @map("is_enabled")
  /// Si es true, tras el sello HABILISALUD el consultorio debe firmar contraparte.
  requiresClinicSignature Boolean @default(false) @map("requires_clinic_signature")
  validityDays Int?             @map("validity_days")
  /// Persona responsable del documento (distinta de quien carga el archivo).
  responsibleName String?       @map("responsible_name") @db.VarChar(160)
  /// Área responsable (ej. Servicios generales, Calidad).
  responsibleArea String?       @map("responsible_area") @db.VarChar(120)
  /// Archivado lógico: el documento y sus versiones se conservan para trazabilidad.
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  files DocumentFile[]

  @@unique([clinicId, code])
  @@index([clinicId, categoryId])
  @@map("document_requirements")
}

model DocumentFile {
  id            String             @id @default(uuid()) @db.Uuid
  requirementId String             @map("requirement_id") @db.Uuid
  requirement   DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  uploadedById  String             @map("uploaded_by_id") @db.Uuid
  uploadedBy    User               @relation(fields: [uploadedById], references: [id])
  /// Número de versión dentro del requisito (1, 2, 3…). Nunca se reutiliza.
  version       Int                @default(1)
  /// Etiqueta de periodo opcional (ej. "2026-08") para actas mensuales.
  periodLabel   String?            @map("period_label") @db.VarChar(40)
  status        DocumentFileStatus @default(PENDING_SIGNATURE)
  originalName  String             @map("original_name") @db.VarChar(255)
  storageKey    String             @map("storage_key")
  mimeType      String             @map("mime_type") @db.VarChar(80)
  sizeBytes     Int                @map("size_bytes")
  checksum      String?            @db.VarChar(128)
  expiresAt     DateTime?          @map("expires_at") @db.Timestamptz(6)
  /// Fecha de emisión del documento (no la de carga).
  issuedAt      DateTime?          @map("issued_at") @db.Timestamptz(6)
  /// Motivo del cambio al cargar una nueva versión.
  changeReason  String?            @map("change_reason")
  notes         String?
  /// Campos diligenciados (líneas punteadas / formulario) de esta versión.
  formData      Json?              @map("form_data")
  retiredAt     DateTime?          @map("retired_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  signatures DocumentSignature[]

  @@unique([requirementId, version])
  @@index([requirementId, status])
  @@map("document_files")
}

model DocumentSignature {
  id               String             @id @default(uuid()) @db.Uuid
  documentFileId   String             @map("document_file_id") @db.Uuid
  documentFile     DocumentFile       @relation(fields: [documentFileId], references: [id], onDelete: Cascade)
  role             DocumentSignerRole
  signerUserId     String?            @map("signer_user_id") @db.Uuid
  signerUser       User?              @relation(fields: [signerUserId], references: [id], onDelete: SetNull)
  signerName       String             @map("signer_name") @db.VarChar(160)
  signatureBase64  String             @map("signature_base64")
  contentHash      String?            @map("content_hash") @db.VarChar(128)
  ipAddress        String?            @map("ip_address") @db.VarChar(60)
  userAgent        String?            @map("user_agent")
  signedAt         DateTime           @default(now()) @map("signed_at") @db.Timestamptz(6)

  @@unique([documentFileId, role])
  @@index([documentFileId])
  @@map("document_signatures")
}

model EquipmentResume {
  id                String          @id @default(uuid()) @db.Uuid
  clinicId          String          @map("clinic_id") @db.Uuid
  clinic            Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name              String          @db.VarChar(160)
  brand             String?         @db.VarChar(120)
  serial            String?         @db.VarChar(120)
  location          String?         @db.VarChar(120)
  lastCalibrationAt DateTime?       @map("last_calibration_at") @db.Timestamptz(6)
  nextCalibrationAt DateTime?       @map("next_calibration_at") @db.Timestamptz(6)
  status            EquipmentStatus @default(ACTIVE)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  maintenances EquipmentMaintenance[]

  @@index([clinicId, nextCalibrationAt])
  @@map("equipment_resumes")
}

model EquipmentMaintenance {
  id            String          @id @default(uuid()) @db.Uuid
  equipmentId   String          @map("equipment_id") @db.Uuid
  equipment     EquipmentResume @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedAt   DateTime        @map("performed_at") @db.Timestamptz(6)
  nextDueAt     DateTime?       @map("next_due_at") @db.Timestamptz(6)
  notes         String?
  attachmentKey String?         @map("attachment_key")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([equipmentId, performedAt])
  @@map("equipment_maintenances")
}

model SupplyItem {
  id        String         @id @default(uuid()) @db.Uuid
  clinicId  String         @map("clinic_id") @db.Uuid
  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String         @db.VarChar(160)
  lotNumber String?        @map("lot_number") @db.VarChar(80)
  expiresAt DateTime?      @map("expires_at") @db.Timestamptz(6)
  quantity  Int            @default(0)
  category  SupplyCategory @default(CONSUMABLE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clinicId, expiresAt])
  @@map("supply_items")
}

model ExpiryAlert {
  id         String             @id @default(uuid()) @db.Uuid
  clinicId   String             @map("clinic_id") @db.Uuid
  clinic     Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  entityType String             @map("entity_type") @db.VarChar(80)
  entityId   String             @map("entity_id") @db.VarChar(80)
  dueAt      DateTime           @map("due_at") @db.Timestamptz(6)
  remindAt30 DateTime?          @map("remind_at_30") @db.Timestamptz(6)
  remindAt15 DateTime?          @map("remind_at_15") @db.Timestamptz(6)
  channel    ExpiryAlertChannel @default(UI)
  sentAt     DateTime?          @map("sent_at") @db.Timestamptz(6)
  status     ExpiryAlertStatus  @default(PENDING)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clinicId, status, dueAt])
  @@index([entityType, entityId])
  @@map("expiry_alerts")
}

model RepsChecklist {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(160)
  standardCode String   @map("standard_code") @db.VarChar(60)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items RepsChecklistItem[]

  @@index([clinicId, standardCode])
  @@map("reps_checklists")
}

model RepsChecklistItem {
  id             String        @id @default(uuid()) @db.Uuid
  checklistId    String        @map("checklist_id") @db.Uuid
  checklist      RepsChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemCode       String        @map("item_code") @db.VarChar(60)
  title          String        @db.VarChar(255)
  result         RepsResult    @default(NA)
  evidenceFileId String?       @map("evidence_file_id") @db.Uuid
  evaluatedAt    DateTime?     @map("evaluated_at") @db.Timestamptz(6)
  notes          String?

  @@unique([checklistId, itemCode])
  @@map("reps_checklist_items")
}

/// Seguimiento longitudinal de ortodoncia por paciente (aparatología, controles,
/// retención y presupuesto). Sigue editable después de firmar la historia, que
/// queda como fotografía del estado al firmar.
model OrthoTracking {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String   @unique @map("patient_id") @db.Uuid
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data          Json     @default("{}")
  version       Int      @default(1)
  createdById   String?  @map("created_by_id") @db.Uuid
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedByName String?  @map("updated_by_name") @db.VarChar(160)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clinicId])
  @@map("ortho_tracking")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  clinicId   String?     @map("clinic_id") @db.Uuid
  clinic     Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  userId     String?     @map("user_id") @db.Uuid
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(80)
  entityId   String?     @map("entity_id") @db.VarChar(80)
  ipAddress  String?     @map("ip_address") @db.VarChar(60)
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clinicId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Binarios de documentos/adjuntos/PDFs en Postgres (fuente de verdad).
/// El disco `storage/` se usa como espejo local; al leer se prioriza esta tabla.
model StoredFile {
  id          String   @id @default(uuid()) @db.Uuid
  storageKey  String   @unique @map("storage_key")
  mimeType    String   @map("mime_type") @db.VarChar(80)
  sizeBytes   Int      @map("size_bytes")
  contentHash String?  @map("content_hash") @db.VarChar(128)
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("stored_files")
}

enum ClinicLogoKind {
  HOME
  HC
  /// Hoja membretada A4 completa que se usa como fondo del PDF de la historia.
  LETTERHEAD
  /// Logo de los formatos administrativos (p. ej. control de citas de psicología).
  FORMS
}

/// Logo propio del consultorio. Tabla aparte de Clinic: copiar o replicar un consultorio no lo arrastra.
model ClinicLogo {
  clinicId  String         @map("clinic_id") @db.Uuid
  kind      ClinicLogoKind
  mimeType  String         @map("mime_type") @db.VarChar(40)
  data      Bytes
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([clinicId, kind])
  @@map("clinic_logos")
}

/// Formato PSI-ADM-01 «Control de citas y asistencia». Documento administrativo: no guarda diagnósticos ni contenido de sesiones.
model AttendanceControl {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String?  @map("patient_id") @db.Uuid
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  /// Nombre del usuario tal como quedó en el formato (para listar sin abrir el JSON).
  patientName String   @map("patient_name") @db.VarChar(160)
  data        Json
  createdById String   @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clinicId, updatedAt])
  @@index([patientId])
  @@map("attendance_controls")
}

/// Informe psicológico editable. La firma es una imagen opcional que carga el profesional.
model PsychReport {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String?  @map("patient_id") @db.Uuid
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName   String   @map("patient_name") @db.VarChar(160)
  reportNumber  String   @default("") @map("report_number") @db.VarChar(40)
  data          Json
  signatureData Bytes?   @map("signature_data")
  signatureMime String?  @map("signature_mime") @db.VarChar(20)
  createdById   String   @map("created_by_id") @db.Uuid
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clinicId, updatedAt])
  @@index([patientId])
  @@map("psych_reports")
}
